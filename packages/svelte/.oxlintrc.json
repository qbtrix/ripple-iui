// oxlint first-pass config — correctness at error, suspicious at warn,
// type-aware via oxlint-tsgolint. Rules with pre-existing findings are downgraded
// to warn (documented in the PR) so the gate lands green; unicorn/no-thenable is
// off because ripple's flow-action DSL uses `then` as a schema field.
// 2026-09-17: ratcheted no-base-to-string, no-floating-promises and
// await-thenable to error — their findings were fixed (fix/oxlint-bug-classes).
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "unicorn/no-thenable": "off",
    "typescript/no-base-to-string": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-redundant-type-constituents": "warn",
    "typescript/await-thenable": "error",
    "no-unused-vars": "warn",
    "no-useless-escape": "warn",
    "no-unused-expressions": "warn",
    "require-yield": "warn",
    "unicorn/no-useless-fallback-in-spread": "warn",
    "unicorn/no-new-array": "warn"
  },
  "ignorePatterns": ["dist/**", "build/**", ".svelte-kit/**", "static/**", "node_modules/**"]
}
