{
  "name": "ripple-iui",
  "version": "0.0.0",
  "private": true,
  "description": "Ripple — a spec-driven UI engine and its renderers. The engine is framework-agnostic; each renderer is its own package.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @ripple-ui/svelte dev",
    "build": "bun run --filter '*' build",
    "check": "bun run --filter '*' check",
    "test": "bun run --filter '*' test",
    "verify": "bun run scripts/verify.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
