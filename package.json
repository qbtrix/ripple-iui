{
  "name": "@ripple-ui/svelte",
  "version": "0.3.1",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./widgets": {
      "types": "./dist/widgets/index.d.ts",
      "svelte": "./dist/widgets/index.js",
      "default": "./dist/widgets/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./streaming": {
      "types": "./dist/streaming/index.d.ts",
      "svelte": "./dist/streaming/index.js",
      "default": "./dist/streaming/index.js"
    },
    "./theme.css": "./dist/theme.css"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-package && bun run scripts/build-manifest.ts",
    "build:manifest": "bun run scripts/build-manifest.ts",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest",
    "package": "svelte-package"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@google/model-viewer": "^4.2.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "@lucide/svelte": "1.16.0",
    "@tiptap/core": "^3.22.5",
    "@tiptap/pm": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "@types/leaflet": "^1.9.21",
    "@xyflow/svelte": "^1.5.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "d3-scale": "^4.0.0",
    "diff": "^9.0.0",
    "driver.js": "^1.4.0",
    "echarts": "^6.0.0",
    "elkjs": "^0.11.1",
    "esm-env": "^1.2.2",
    "frappe-gantt": "^1.2.2",
    "layerchart": "2.0.0-next.43",
    "leaflet": "^1.9.4",
    "marked": "^18.0.2",
    "muuri": "^0.9.5",
    "partial-json": "0.1.7",
    "qrcode-svg": "^1.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.0",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-scale": "^4.0.0",
    "bits-ui": "^2.16.3",
    "jsdom": "^29.0.2",
    "svelte": "^5.51.0",
    "svelte-check": "^4.4.2",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.0"
  }
}
